{
  "expo": {
    "name": "DermSight",
    "slug": "dermsight",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "scheme": "dermsight",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dermsight.app",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.dermsight.app",
      "adaptiveIcon": {
        "backgroundColor": "#0D9E94",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DermSight to add location to patient records for better follow-up."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DermSight to capture images of skin lesions for assessment."
        }
      ],
      [
        "react-native-fast-tflite",
        {}
      ],
      [
        "expo-dev-client",
        {}
      ],
      "expo-sharing",
      "expo-background-task",
      [
        "expo-notifications",
        {
          "color": "#0D9E94",
          "defaultChannel": "sync"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aeef8058-6615-4870-bbd3-29a6f7b57db0"
      }
    },
    "owner": "adeeltahir"
  }
}
